  "cards": [
    {
      "dot": "cyan",
      "title": "Product modules",
      "items": [
        "React routes lead to dashboards, Explore, SQL Lab, and administration.",
        "REST APIs delegate writes to typed command and DAO layers.",
        "Engine specifications isolate database dialect and execution behavior."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data boundaries",
      "items": [
        "The metadata database owns identities, definitions, permissions, and operational state.",
        "Analytical databases remain the systems of record for business data.",
        "Cache and broker services are operator-controlled infrastructure."
      ]
    },
    {
      "dot": "violet",
      "title": "Automation opportunity",
      "items": [
        "Alembic revisions evolve the metadata plane and can block every deployment.",
        "Upgrade, downgrade, and re-upgrade checks provide a deterministic oracle.",
        "Devin can investigate and repair a reproduced migration contract failure."
      ]
    }
  ]
